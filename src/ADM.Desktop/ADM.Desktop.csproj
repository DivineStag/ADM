<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF><OutputType>WinExe</OutputType><Version>0.8.0-beta.8</Version><AssemblyVersion>0.8.0.0</AssemblyVersion><PlatformTarget>x64</PlatformTarget><GitHubRepository Condition="'$(GitHubRepository)' == ''">DivineStag/ADM</GitHubRepository><ApplicationIcon>Assets\ADM.ico</ApplicationIcon></PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="GitHubRepository" Value="$(GitHubRepository)" />
    <ProjectReference Include="..\ADM.Conversation\ADM.Conversation.csproj" />
    <ProjectReference Include="..\ADM.Operations\ADM.Operations.csproj" />
    <ProjectReference Include="..\ADM.Simulation\ADM.Simulation.csproj" />
    <Resource Include="Assets\ADM.ico" />
    <Content Include="..\..\profiles\bundled\*.json" Link="Defaults\Profiles\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\incoming.mp3" Condition="Exists('Assets\incoming.mp3')" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\incoming.wav" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\outgoing.mp3" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="..\ADM.Application\ADM.Application.csproj" />
    <ProjectReference Include="..\ADM.Infrastructure\ADM.Infrastructure.csproj" />
    <ProjectReference Include="..\ADM.Integrations.Gsx\ADM.Integrations.Gsx.csproj" />
    <ProjectReference Include="..\ADM.Integrations.Sim\ADM.Integrations.Sim.csproj" />
<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>
</Project>

