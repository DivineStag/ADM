<Window x:Class="ADM.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ADM.Desktop" xmlns:views="clr-namespace:ADM.Desktop.Views" xmlns:text="clr-namespace:ADM.Desktop.Resources"
        Title="ADM · Aircraft Dispatch Manager" Width="490" Height="860" MinWidth="420" MinHeight="640"
        WindowStyle="SingleBorderWindow" Icon="Assets/ADM.ico" Topmost="False" ResizeMode="CanResize" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI Variable Text, Segoe UI" WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        AutomationProperties.Name="Aircraft Dispatch Manager">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource MutedInk}" /><Setter Property="Padding" Value="3,8" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="13" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <Path Data="{TemplateBinding Tag}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" Width="21" Height="21" Stretch="Uniform" Margin="0,0,0,6" />
                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource Raised}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavBorder" Property="BorderBrush" Value="{DynamicResource Accent}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="WindowSurface" Background="{DynamicResource Canvas}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="0" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="76" /></Grid.RowDefinitions>
            <Grid Grid.Row="1" Margin="22,10,22,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Background="{DynamicResource Avatar}" CornerRadius="24" Width="48" Height="48" VerticalAlignment="Top" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding HeaderInitials}" FontSize="26" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding HeaderName}" FontSize="25" FontWeight="SemiBold" /></StackPanel>
                    <TextBlock Text="{Binding HeaderFlight}" Style="{StaticResource Caption}" Margin="0,5,0,0" />
                    <WrapPanel Margin="0,6,0,0">
                        <TextBlock Text="{Binding HeaderStage}" FontSize="11" Foreground="{DynamicResource Accent}" Margin="0,0,10,4" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource Raised}" CornerRadius="7" Padding="7,4" Margin="0,0,0,4"><TextBlock Text="{Binding HeaderGate}" Style="{StaticResource Caption}" FontSize="10" /></Border>
                    </WrapPanel>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="2" Margin="22,0,22,14">
                <Border Background="{DynamicResource AccentSoft}" CornerRadius="9" Padding="11,8">
                    <DockPanel><Ellipse DockPanel.Dock="Left" Width="5" Height="5" Fill="{DynamicResource Accent}" Margin="0,0,8,0" /><TextBlock Text="{Binding ConnectionText}" Style="{StaticResource Eyebrow}" FontSize="9" Foreground="{DynamicResource Accent}" /></DockPanel>
                </Border>
                <Border Background="{DynamicResource Raised}" CornerRadius="10" Padding="12" Margin="0,8,0,0" Visibility="{Binding ShowDemoRecovery, Converter={StaticResource VisibleIf}}">
                    <TextBlock Text="{Binding Demo.RecoveryText}" FontSize="12" AutomationProperties.LiveSetting="Assertive" />
                </Border>
            </StackPanel>
            <Grid Grid.Row="3" Margin="22,0,17,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid>
                    <views:ChatView x:Name="Chat" DataContext="{Binding Demo}" Visibility="{Binding DataContext.ShowDemoChat, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleIf}}" />
                    <views:LiveChatView DataContext="{Binding Live}" Visibility="{Binding DataContext.ShowLiveChat, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleIf}}" />
<views:ProfilesView x:Name="ProfilesPage" Visibility="{Binding IsProfiles, Converter={StaticResource VisibleIf}}" />
<views:FlightView x:Name="FlightPage" Visibility="{Binding IsFlight, Converter={StaticResource VisibleIf}}" />
                    <views:SettingsView x:Name="SettingsPage" Visibility="{Binding IsSettings, Converter={StaticResource VisibleIf}}" />
                </Grid>
            </Grid>
            <Border Grid.Row="4" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Margin="22,6,22,0" Padding="0,6,0,6">
                <UniformGrid Columns="4" KeyboardNavigation.TabNavigation="Continue">
                    <Button x:Name="ChatNav" Content="{x:Static text:UiText.Chat}" Tag="{StaticResource ChatIcon}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static local:AppPage.Chat}" Margin="0,0,4,0" AutomationProperties.Name="{x:Static text:UiText.Chat}">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsChat}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}" /><Setter Property="Background" Value="{DynamicResource AccentSoft}" /></DataTrigger></Style.Triggers></Style></Button.Style>
                    </Button>
                    <Button x:Name="ProfilesNav" Content="Profiles" Tag="{StaticResource ServicesIcon}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static local:AppPage.Profiles}" Margin="0,0,4,0" AutomationProperties.Name="Profiles">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsProfiles}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}" /><Setter Property="Background" Value="{DynamicResource AccentSoft}" /></DataTrigger></Style.Triggers></Style></Button.Style>
                    </Button>
                    <Button x:Name="FlightNav" Content="{x:Static text:UiText.Flight}" Tag="{StaticResource FlightIcon}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static local:AppPage.Flight}" Margin="0,0,4,0" AutomationProperties.Name="{x:Static text:UiText.Flight}">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsFlight}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}" /><Setter Property="Background" Value="{DynamicResource AccentSoft}" /></DataTrigger></Style.Triggers></Style></Button.Style>
                    </Button>
                    <Button x:Name="SettingsNav" Content="{x:Static text:UiText.Settings}" Tag="{StaticResource SettingsIcon}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static local:AppPage.Settings}" AutomationProperties.Name="{x:Static text:UiText.Settings}">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsSettings}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}" /><Setter Property="Background" Value="{DynamicResource AccentSoft}" /></DataTrigger></Style.Triggers></Style></Button.Style>
                    </Button>
                </UniformGrid>
            </Border>
        </Grid>
    </Border>
</Window>



